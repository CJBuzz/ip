<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         spacing="10.0" styleClass="dialog-box" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" styleClass="dialog-text" wrapText="true" />
        <Label fx:id="speaker" styleClass="speaker" />
    </children>
    <padding>
        <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
    </padding>
</fx:root>
